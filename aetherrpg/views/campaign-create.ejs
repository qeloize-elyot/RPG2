<%- include('partials/header') %>
<section class="section">
  <div class="container" style="max-width:560px">
    <h1>Nova Campanha</h1>
    <div class="ornament"><span></span></div>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <form method="POST" action="/campaigns/create" class="card">
      <div class="form-group">
        <label for="name">Nome da campanha</label>
        <input type="text" id="name" name="name" class="form-control" required>
      </div>
      <div class="form-group">
        <label for="description">Sinopse</label>
        <textarea id="description" name="description" class="form-control" rows="3"></textarea>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="system">Sistema</label>
          <select id="system" name="system" class="form-control">
            <option>D&D 5e</option>
            <option>Pathfinder 2e</option>
            <option>Call of Cthulhu</option>
            <option>Vampiro</option>
            <option>Tormenta 20</option>
            <option>Sistema próprio</option>
            <option>Outro</option>
          </select>
        </div>
        <div class="form-group">
          <label for="style">Estilo</label>
          <select id="style" name="style" class="form-control">
            <option>Fantasia Sombria</option>
            <option>Alta Fantasia</option>
            <option>Horror</option>
            <option>Investigação</option>
            <option>Sandbox</option>
            <option>West Marches</option>
          </select>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="max_players">Máx. jogadores</label>
          <input type="number" id="max_players" name="max_players" class="form-control" value="6" min="2" max="12">
        </div>
        <div class="form-group" style="display:flex;align-items:flex-end">
          <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer">
            <input type="checkbox" name="is_public" checked> Pública (listada)
          </label>
        </div>
      </div>
      <button type="submit" class="btn btn-primary">Criar Campanha</button>
    </form>
  </div>
</section>
<%- include('partials/footer') %>
