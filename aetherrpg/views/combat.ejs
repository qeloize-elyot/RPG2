<%- include('partials/header') %>
<section class="section">
  <div class="container" style="max-width:640px">
    <div class="section-header">
      <h1>Rastreador de Combate</h1>
      <span id="combat-round" class="badge badge-active">Rodada 1</span>
    </div>

    <div class="card mb-2">
      <div class="form-row">
        <div class="form-group">
          <label>Nome</label>
          <input type="text" id="combat-name" class="form-control" placeholder="Goblin">
        </div>
        <div class="form-group">
          <label>Iniciativa</label>
          <input type="number" id="combat-init" class="form-control" placeholder="15">
        </div>
        <div class="form-group">
          <label>PV</label>
          <input type="number" id="combat-hp" class="form-control" placeholder="7">
        </div>
      </div>
      <div class="flex gap-1 flex-wrap">
        <button type="button" id="combat-add" class="btn btn-sm btn-primary">Adicionar</button>
        <button type="button" id="combat-next" class="btn btn-sm">Próximo turno</button>
        <button type="button" id="combat-clear" class="btn btn-sm btn-ghost">Limpar</button>
      </div>
    </div>

    <ul id="combat-list" class="combat-list"></ul>
  </div>
</section>
<script src="/js/combat.js"></script>
<%- include('partials/footer') %>
