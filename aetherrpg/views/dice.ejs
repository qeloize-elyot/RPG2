<%- include('partials/header') %>
<section class="section">
  <div class="container" style="max-width:560px">
    <h1>Rolador de Dados</h1>
    <div class="ornament"><span></span></div>

    <div class="dice-panel">
      <div class="dice-buttons">
        <button type="button" class="dice-btn" data-sides="4">d4</button>
        <button type="button" class="dice-btn" data-sides="6">d6</button>
        <button type="button" class="dice-btn" data-sides="8">d8</button>
        <button type="button" class="dice-btn" data-sides="10">d10</button>
        <button type="button" class="dice-btn" data-sides="12">d12</button>
        <button type="button" class="dice-btn" data-sides="20">d20</button>
        <button type="button" class="dice-btn" data-sides="100">d100</button>
      </div>

      <div class="form-group">
        <label for="custom-formula">Fórmula customizada</label>
        <div class="flex gap-1">
          <input type="text" id="custom-formula" class="form-control" placeholder="2d6+3 ou 1d20+5">
          <button type="button" id="roll-custom" class="btn btn-primary">Rolar</button>
        </div>
      </div>

      <div class="dice-result mt-2">
        <div class="total" id="dice-result">—</div>
        <div class="detail" id="dice-detail">Escolha um dado ou digite uma fórmula</div>
      </div>

      <h3 class="mt-3">Histórico</h3>
      <ul id="dice-history" style="list-style:none;max-height:200px;overflow-y:auto"></ul>
    </div>
  </div>
</section>
<script src="/js/dice.js"></script>
<%- include('partials/footer') %>
