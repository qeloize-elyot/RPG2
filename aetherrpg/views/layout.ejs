<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="AetherRPG — Plataforma profissional de RPG de mesa com estética dark fantasy gótica.">
  <title><%= typeof title !== 'undefined' ? title + ' · AetherRPG' : 'AetherRPG' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚔</text></svg>">
</head>
<body>
  <nav class="navbar">
    <div class="container navbar-inner">
      <a href="/" class="logo">Aether<span>RPG</span></a>
      <button class="nav-toggle" type="button" aria-label="Menu">Menu</button>
      <ul class="nav-links">
        <% if (user) { %>
          <li><a href="/dashboard" class="<%= currentPath === '/dashboard' ? 'active' : '' %>">Santuário</a></li>
          <li><a href="/campaigns" class="<%= currentPath.startsWith('/campaigns') ? 'active' : '' %>">Campanhas</a></li>
          <li><a href="/characters" class="<%= currentPath.startsWith('/characters') ? 'active' : '' %>">Personagens</a></li>
          <li><a href="/tools" class="<%= currentPath.startsWith('/tools') ? 'active' : '' %>">Ferramentas</a></li>
          <li><a href="/profile"><%= user.display_name || user.username %></a></li>
          <li><a href="/logout">Sair</a></li>
        <% } else { %>
          <li><a href="/login">Entrar</a></li>
          <li><a href="/register" class="btn btn-sm">Registrar</a></li>
        <% } %>
      </ul>
    </div>
  </nav>

  <main>
    <%- body %>
  </main>

  <footer class="footer">
    <div class="container">
      <p>AetherRPG — Portal das Sombras · Ferramentas para mestres e aventureiros</p>
      <p class="mt-1"><span class="text-muted">Estética dark fantasy · Dados locais · Código aberto para sua mesa</span></p>
    </div>
  </footer>

  <script src="/js/main.js"></script>
  <% if (typeof scripts !== 'undefined') { %>
    <% scripts.forEach(function(s) { %>
      <script src="<%= s %>"></script>
    <% }) %>
  <% } %>
</body>
</html>
